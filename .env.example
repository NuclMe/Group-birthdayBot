BOT_TOKEN=
# Логин и пароль root-пользователя MongoDB (используются docker compose при первом создании тома).
MONGO_ROOT_USERNAME=birthday_root
MONGO_ROOT_PASSWORD=
# Те же логин и пароль; спецсимволы в пароле нужно URL-кодировать (или используйте только буквы и цифры).
MONGODB_URI=mongodb://birthday_root:CHANGE_ME@mongodb:27017/?authSource=admin
MONGODB_DATABASE=birthday_bot
TARGET_CHAT_ID=
OWNER_TELEGRAM_ID=
TIMEZONE=Europe/Kyiv
MONTHLY_SUMMARY_HOUR=9
BIRTHDAY_MESSAGE_HOUR=10
